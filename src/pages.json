{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "GearFlow"
      }
    },
    {
      "path": "pages/devices/index",
      "style": {
        "navigationBarTitleText": "设备",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/devices/edit",
      "style": {
        "navigationBarTitleText": "设备信息"
      }
    },
    {
      "path": "pages/devices/detail",
      "style": {
        "navigationBarTitleText": "设备详情"
      }
    },
    {
      "path": "pages/devices/maintenance",
      "style": {
        "navigationBarTitleText": "维护记录"
      }
    },
    {
      "path": "pages/stats/index",
      "style": {
        "navigationBarTitleText": "数据"
      }
    },
    {
      "path": "pages/stats/annual",
      "style": { "navigationBarTitleText": "年度设备报告" }
    },
    { "path": "pages/devices/attachments", "style": { "navigationBarTitleText": "照片与发票" } },
    { "path": "pages/devices/dispose", "style": { "navigationBarTitleText": "设备处置" } },
    { "path": "pages/devices/reminders", "style": { "navigationBarTitleText": "保修提醒" } },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/profile/backup",
      "style": { "navigationBarTitleText": "备份与恢复" }
    },
    {
      "path": "pages/onboarding/index",
      "style": {
        "navigationBarTitleText": "欢迎使用 GearFlow",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile/agreement",
      "style": {
        "navigationBarTitleText": "协议"
      }
    }
  ],
  "tabBar": {
    "color": "#80868b",
    "selectedColor": "#1a73e8",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tabbar/home-normal.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/devices/index",
        "text": "设备",
        "iconPath": "static/tabbar/devices-normal.png",
        "selectedIconPath": "static/tabbar/devices-active.png"
      },
      {
        "pagePath": "pages/stats/index",
        "text": "数据",
        "iconPath": "static/tabbar/stats-normal.png",
        "selectedIconPath": "static/tabbar/stats-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile-normal.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "GearFlow",
    "navigationBarBackgroundColor": "#F8F9FA",
    "backgroundColor": "#F8F9FA"
  }
}
