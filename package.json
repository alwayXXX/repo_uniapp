{
  "name": "gearflow",
  "version": "0.1.0",
  "private": true,
  "description": "GearFlow - 个人数码设备资产管理（微信小程序）",
  "scripts": {
    "prepare": "husky",
    "dev:mp-weixin": "uni -p mp-weixin",
