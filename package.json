    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.9.0",
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "pinia": "^2.3.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/runtime-core": "^3.4.21",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^20.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "miniprogram-automator": "^0.12.1",
    "prettier": "^3.3.3",
    "sass": "^1.103.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.20.0",
    "vite": "5.2.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
